datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  ADMIN
  TREASURER
  MEMBER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(MEMBER)
  
  accounts Account[]
  sessions Session[]
  member   Member?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Member {
  id            String    @id @default(cuid())
  userId        String    @unique
  name          String
  email         String    @unique
  memberSince   DateTime  @default(now())
  avatarUrl     String?
  status        String    @default("active") // "active" | "inactive"

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions   Contribution[]
  welfareRequests WelfareRequest[]
}

model Contribution {
  id            String   @id @default(cuid())
  memberId      String
  memberName    String
  date          DateTime
  amount        Float
  method        String
  isAnomalous   Boolean? @default(false)
  anomalyReason String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model WelfareRequest {
  id          String   @id @default(cuid())
  memberId    String
  memberName  String
  requestDate DateTime @default(now())
  amount      Float
  reason      String
  status      String   // "Pending" | "Approved" | "Rejected" | "Disbursed"

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}
